# ─────────────────────────────────────────────────────────────
#  Dayflow HRMS – Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit your actual .env to version control.
# ─────────────────────────────────────────────────────────────

# Any long random string used to sign / verify JWT tokens.
# Change this to something unique before deploying!
JWT_SECRET=dayflow_super_secret_change_this_in_production

# Port the Express server will listen on.
PORT=5000

# Google Gemini API key for the AI HR Assistant.
# Get a free key at https://aistudio.google.com → "Get API Key"
GEMINI_API_KEY=your_gemini_api_key_here
